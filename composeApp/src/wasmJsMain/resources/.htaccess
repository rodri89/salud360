# Salud 360 web (Kotlin/Wasm) en Apache de hosting compartido.
# Se copia tal cual al paquete de producción (wasmJsBrowserDistribution).

# Tipos MIME: el navegador rechaza el .wasm si no llega como application/wasm.
AddType application/wasm .wasm
AddType application/javascript .js .mjs
AddType application/json .json

# Compresión para JS/Wasm (el bundle pesa varios MB).
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/wasm application/javascript text/html text/css application/json
</IfModule>

# Los archivos con hash en el nombre pueden cachearse mucho; index.html y salud360.js no.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType application/wasm "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "^(index\.html|salud360\.js)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

# Sin listado de directorios.
Options -Indexes

# La carpeta vive dentro del public_html de la web de turnos (Laravel). Con RewriteEngine propio, las reglas de
# reescritura del .htaccess padre (que mandan todo a index.php) no se heredan acá: se sirven los archivos tal cual.
<IfModule mod_rewrite.c>
    RewriteEngine On
</IfModule>
